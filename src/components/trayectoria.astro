---
const history = [
  {
    date: "Junio 2024",
    title: "Graduado como FullStack Developer",
    description:
      "Completé la certificación FullStack en CoderHouse, destacándome en el Top 10 de mi comisión.",
    image: "/certificados/FullStack-CoderHouse.png",
    link: "https://pub.coderhouse.com/legacy-certificates/6785891c10ebc8636ba2449f?lang=es",
  },
  {
    date: "Mayo 2024",
    title: "Certificación Backend Developer",
    description:
      "Aprendí a construir **APIs escalables**, autenticación segura con **JWT** y gestión de bases de datos **MongoDB**.",
    image: "/certificados/Backend 3.png",
    link: "https://pub.coderhouse.com/legacy-certificates/67834aa43a9c47bbd7ed6e25?lang=es",
  },
  {
    date: "Marzo 2024",
    title: "Certificación Frontend Developer",
    description:
      "Desarrollé interfaces interactivas con **React**, optimización de rendimiento y **CSS avanzado**.",
    image: "/certificados/FrontEnd-React.png",
    link: "https://pub.coderhouse.com/legacy-certificates/66963457b3de3191d9b25439?lang=es",
  },
  {
    date: "Enero 2018",
    title: "Inicio de Ingeniería Electrónica",
    description:
      "Desarrollé habilidades en **sistemas embebidos**, redes de comunicación y automatización aplicada a IoT.",
  },
];
---

<section
  id="trayectoria"
  class="relative min-h-screen max-w-4xl mx-auto py-10 px-4"
>
  <h1 class="text-4xl font-bold text-white text-center">
    Trayectoria Profesional
  </h1>
  <div class="mt-6 border-l-4 border-blue-500 pl-6">
    {
      history.map((item) => (
        <div class="flex flex-col md:flex-row items-start gap-2 mb-8 md:items-center">
          {item.image && (
            <a href={item.link} target="_blank">
              <img
                src={item.image}
                alt={item.title}
                class="mt-3 rounded-lg shadow-md hover:scale-105 transition-transform max-w-xs w-40 mx-auto block"
              />
            </a>
          )}
          <div>
            <h2 class="text-lg font-semibold text-white">{item.title}</h2>
            <p class="text-gray-400">{item.description}</p>
          </div>
          <span class="block text-gray-500 text-sm mt-2">{item.date}</span>
        </div>
      ))
    }
  </div>
  <style>
    #trayectoria::after {
      content: "";
      position: absolute;
      top: 20px;
      left: 20px;
      width: 220px;
      height: 220px;
      background: url("/logos/miLogo.svg") no-repeat center;
      background-size: contain;
      opacity: 0.6;
      pointer-events: none;
    }

    #trayectoria::before {
      content: "";
      position: absolute;
      bottom: 50px;
      right: 50px;
      width: 200px;
      height: 200px;
      background: url("/logos/codeIcon.svg") no-repeat center;
      background-size: contain;
      opacity: 0.6;
      pointer-events: none;
    }
  </style>
</section>
