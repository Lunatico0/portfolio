---
import Carousel from "../Carousel.astro";
import ProjectCard from "../ProjectCard.astro";

const projects = [
  {
    title: "Artemisa E-commerce",
    description:
      "Desarrollo de una tienda en línea con Node.js, Express y MongoDB.",
    link: "https://www.artemisa-pvc.com",
    tech: ["Node.js", "Express", "MongoDB", "JWT", "MercadoPago"],
    images: {
      desktop: [
        "/img/proyecto1/desktop.png",
        "/img/proyecto1/desktop1.png",
        "/img/proyecto1/desktop2.png",
        "/img/proyecto1/desktop3.png",
      ],
      mobile: [
        "/img/proyecto1/proyecto1-mobile1.png",
        "/img/proyecto1/proyecto1-mobile2.png",
        "/img/proyecto1/proyecto1-mobile3.png",
        "/img/proyecto1/proyecto1-mobile4.png",
        "/img/proyecto1/proyecto1-mobile5.png",
      ],
    },
  },
  {
    title: "Electricidad Pittana",
    description: "Sitio web para un taller de electricidad automotriz.",
    link: "https://electricidad-pittana.netlify.app/",
    tech: ["HTML", "CSS", "Bootstrap"],
    images: {
      desktop: [
        "/img/proyecto2/desktop.png",
        "/img/proyecto2/desktop2.png",
        "/img/proyecto2/desktop3.png",
        "/img/proyecto2/desktop4.png",
        "/img/proyecto2/desktop5.png",
      ],
      mobile: [
        "/img/proyecto2/proyecto2-mobile1.png",
        "/img/proyecto2/proyecto2-mobile2.png",
        "/img/proyecto2/proyecto2-mobile3.png",
        "/img/proyecto2/proyecto2-mobile4.png",
        "/img/proyecto2/proyecto2-mobile5.png",
      ],
    },
  },
];
---

<section
  id="proyectos"
  class="relative py-10 flex flex-col items-center justify-center bg-cover bg-center"
>
  <h2 class="text-4xl font-bold text-white mb-10">Mis Proyectos</h2>

  <!-- Contenedor de proyectos -->
  <div class="flex flex-col items-center justify-center gap-16">
    {projects.map((project) => <ProjectCard {...project} />)}
  </div>
</section>
