---
import {
  IconBrandWhatsapp,
  IconBrandLinkedin,
  IconMail,
  IconDownload,
} from "@tabler/icons-react";
---

<section
  id="contacto"
  class="relative h-dvh flex flex-col items-center justify-center bg-fixed bg-center bg-opacity-10 backdrop-blur-md p-0 m-0 py-10"
  style="background-image: url('/bg/Logo-4.jpg');"
>
  <h1 class="text-4xl font-bold text-white text-center mb-6">Contacto</h1>

  <p class="text-gray-400 text-center mb-2">
    Puedes contactarme a través de mis redes o llenando el formulario.
  </p>

  <!-- 🔹 Redes Sociales + Tooltip -->
  <div class="flex gap-6 mb-6 relative bg-gray-900 bg-opacity-80 rounded px-4 py-2">
    <div class="group relative flex flex-col items-center">
      <a
        href="https://www.linkedin.com/in/patricio-pittana-2185b6177/"
        target="_blank"
        class="text-white text-3xl hover:text-cyan-400 transition duration-300"
        aria-label="LinkedIn"
      >
        <IconBrandLinkedin stroke={1} />
      </a>
      <span class="tooltip">LinkedIn</span>
    </div>

    <div class="group relative flex flex-col items-center">
      <a
        href="https://wa.me/5493435417146"
        target="_blank"
        class="text-white text-3xl hover:text-green-400 transition duration-300"
        aria-label="WhatsApp"
      >
        <IconBrandWhatsapp stroke={1} />
      </a>
      <span class="tooltip">WhatsApp</span>
    </div>

    <div class="group relative flex flex-col items-center">
      <a
        href="mailto:pittanapatricio@gmail.com"
        class="text-white text-3xl hover:text-gray-400 transition duration-300"
        aria-label="Email"
      >
        <IconMail stroke={1} />
      </a>
      <span class="tooltip">Enviar Email</span>
    </div>

    <!-- Botón para abrir el modal -->
    <div class="group relative flex flex-col items-center">
      <button
        onclick="abrirModalCV()"
        class="text-white text-3xl hover:text-green-400 transition duration-300"
      >
        <IconDownload stroke={1} />
      </button>
      <span class="tooltip">Descargar CV</span>
    </div>
  </div>

  <!-- 🔹 Formulario -->
  <form
    action="https://formsubmit.co/20155a6c76c9eff08f8a5ee46b8170ff"
    method="POST"
    class="bg-gray-900 bg-opacity-80 p-6 rounded-lg w-full max-w-md shadow-lg"
  >
    <div class="mb-4">
      <label class="text-white block mb-1">Nombre y Apellido</label>
      <input
        type="text"
        name="name"
        class="w-full p-2 rounded bg-gray-800 text-white border border-gray-700 focus:outline-none focus:border-cyan-400"
      />
    </div>

    <div class="mb-4">
      <label class="text-white block mb-1">Email</label>
      <input
        type="email"
        name="email"
        required
        class="w-full p-2 rounded bg-gray-800 text-white border border-gray-700 focus:outline-none focus:border-cyan-400"
      />
    </div>

    <div class="mb-4">
      <label class="text-white block mb-1">Mensaje</label>
      <textarea
        name="message"
        required
        class="w-full p-2 rounded bg-gray-800 text-white border border-gray-700 focus:outline-none focus:border-cyan-400"
        rows="4"></textarea>
    </div>

    <input type="hidden" name="_honey" style="display:none;" />
    <input
      type="hidden"
      name="_next"
      value="https://pittanapatricio.vercel.app/"
    />

    <button
      type="submit"
      class="w-full bg-cyan-500 hover:bg-cyan-600 text-white font-bold py-2 px-4 rounded transition duration-300"
    >
      Enviar Mensaje
    </button>
  </form>
</section>

<!-- 🔹 Modal de Descarga de CV (Por defecto oculto) -->
<div id="modal-cv" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center">
  <div class="bg-gray-900 text-white p-6 rounded-lg shadow-lg w-96 relative">
    <h2 class="text-xl font-bold">Descargar CV</h2>
    <p class="text-gray-400 mt-2">Seleccione el idioma:</p>

    <div class="mt-4">
      <label class="flex items-center gap-2">
        <input type="radio" name="cvIdioma" value="es" checked class="accent-green-500"> Español
      </label>
      <label class="flex items-center gap-2 mt-2">
        <input type="radio" name="cvIdioma" value="en" class="accent-green-500"> English
      </label>
    </div>

    <div class="mt-6 flex justify-between">
      <button onclick="descargarCV()" class="bg-green-600 hover:bg-green-700 px-4 py-2 rounded">Descargar</button>
      <button onclick="verOnline()" class="bg-gray-700 hover:bg-gray-600 px-4 py-2 rounded">Ver Online</button>
    </div>

    <button onclick="cerrarModalCV()" class="absolute top-2 right-2 text-gray-400 hover:text-white">✕</button>
  </div>
</div>

<script>
  window.abrirModalCV = () => {
    const modal = document.getElementById("modal-cv");
    modal.classList.remove("hidden");
    modal.classList.add("flex");
  };

  window.cerrarModalCV = () => {
    const modal = document.getElementById("modal-cv");
    modal.classList.remove("flex");
    modal.classList.add("hidden");
  };

  window.descargarCV = () => {
  const idioma = document.querySelector('input[name="cvIdioma"]:checked').value;
  const link = document.createElement("a"); // Crear un enlace dinámico
  link.href = `/CV/CV_Patricio_Pittana_${idioma}.pdf`; // Ruta del archivo
  link.download = `CV_Patricio_Pittana_${idioma}.pdf`; // Nombre del archivo al descargar
  document.body.appendChild(link); // Agregar el enlace al DOM
  link.click(); // Simular el clic para descargar
  document.body.removeChild(link); // Remover el enlace después de descargar
  cerrarModalCV(); // Cerrar el modal
};

// window.descargarCV = () => {
  //   const idioma = document.querySelector('input[name="cvIdioma"]:checked').value;
  //   window.location.href = `/CV/CV_Patricio_Pittana_${idioma}.pdf`;
  //   cerrarModalCV();
  // };

  window.verOnline = () => {
    const idioma = document.querySelector('input[name="cvIdioma"]:checked').value;
    window.open(`/CV/CV_Patricio_Pittana_${idioma}.pdf`, "_blank");
    cerrarModalCV();
  };
</script>

<style>
  .tooltip {
    position: absolute;
    bottom: -30px;
    background-color: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 0.875rem;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transform: translateY(5px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .group:hover .tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
</style>
