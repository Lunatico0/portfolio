---
import { IconBrandWhatsapp, IconBrandLinkedin, IconMail, IconDownload } from "@tabler/icons-react";
---

<section
  id="contacto"
  class="relative h-dvh flex flex-col items-center justify-center bg-fixed bg-center bg-opacity-10 backdrop-blur-md p-0 m-0 py-10"
  style="background-image: url('/bg/Logo-4.jpg');"
>
  <h1 class="text-4xl font-bold text-white text-center mb-6">Contacto</h1>

  <p class="text-gray-400 text-center mb-2">
    Puedes contactarme a través de mis redes o llenando el formulario.
  </p>

  <!-- 🔹 Redes Sociales + Tooltip -->
  <div class="flex gap-6 mb-6 relative">
    <div class="group relative flex flex-col items-center">
      <a
        href="https://www.linkedin.com/in/patricio-pittana-2185b6177/"
        target="_blank"
        class="text-white text-3xl hover:text-cyan-400 transition duration-300"
        aria-label="LinkedIn"
      >
        <IconBrandLinkedin stroke={1} />
      </a>
      <span class="tooltip">LinkedIn</span>
    </div>

    <div class="group relative flex flex-col items-center">
      <a
        href="https://wa.me/5493435417146"
        target="_blank"
        class="text-white text-3xl hover:text-green-400 transition duration-300"
        aria-label="WhatsApp"
      >
        <IconBrandWhatsapp stroke={1} />
      </a>
      <span class="tooltip">WhatsApp</span>
    </div>

    <div class="group relative flex flex-col items-center">
      <a
        href="mailto:pittanapatricio@gmail.com"
        class="text-white text-3xl hover:text-gray-400 transition duration-300"
        aria-label="Email"
      >
        <IconMail stroke={1} />
      </a>
      <span class="tooltip">Enviar Email</span>
    </div>

    <div class="group relative flex flex-col items-center">
      <a
        href="/CV/CV_Patricio_Pittana.pdf"
        download="CV/CV_Patricio_Pittana.pdf"
        class="text-white text-3xl hover:text-green-400 transition duration-300"
        aria-label="CV"
      >
        <IconDownload stroke={1} />
      </a>
      <span class="tooltip">Descargar CV</span>
    </div>
  </div>

  <!-- 🔹 Formulario -->
  <form
    action="https://formsubmit.co/20155a6c76c9eff08f8a5ee46b8170ff"
    method="POST"
    class="bg-gray-900 bg-opacity-80 p-6 rounded-lg w-full max-w-md shadow-lg"
  >
    <div class="mb-4">
      <label class="text-white block mb-1">Nombre y Apellido</label>
      <input
        type="text"
        name="name"
        class="w-full p-2 rounded bg-gray-800 text-white border border-gray-700 focus:outline-none focus:border-cyan-400"
      />
    </div>

    <div class="mb-4">
      <label class="text-white block mb-1">Email</label>
      <input
        type="email"
        name="email"
        required
        class="w-full p-2 rounded bg-gray-800 text-white border border-gray-700 focus:outline-none focus:border-cyan-400"
      />
    </div>

    <div class="mb-4">
      <label class="text-white block mb-1">Mensaje</label>
      <textarea
        name="message"
        required
        class="w-full p-2 rounded bg-gray-800 text-white border border-gray-700 focus:outline-none focus:border-cyan-400"
        rows="4"></textarea>
    </div>

    <input type="hidden" name="_honey" style="display:none;" />
    <input
      type="hidden"
      name="_next"
      value="https://pittanapatricio.vercel.app/"
    />

    <button
      type="submit"
      class="w-full bg-cyan-500 hover:bg-cyan-600 text-white font-bold py-2 px-4 rounded transition duration-300"
    >
      Enviar Mensaje
    </button>
  </form>
</section>

<style>
  .tooltip {
    position: absolute;
    bottom: -30px;
    background-color: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 0.875rem;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transform: translateY(5px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .group:hover .tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
</style>
