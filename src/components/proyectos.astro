---
import ProjectCard from "../components/ProjectCard.astro";

const projects = [
  {
    title: "Artemisa E-commerce",
    description:
      "Desarrollo de una tienda en línea con Node.js, Express y MongoDB.",
    link: "https://www.artemisa-pvc.com",
    tech: ["Node.js", "Express", "MongoDB", "JWT", "MercadoPago"],
  },
  {
    title: "Electricidad Pittana",
    description: "Sitio web para un taller de electricidad automotriz.",
    link: "https://electricidad-pittana.netlify.app/",
    tech: ["HTML", "CSS", "Bootstrap"],
  },
];
---

<section id="proyectos" class="relative max-w-5xl mx-auto py-10 px-4">
  <h1 class="text-4xl font-bold text-white text-center">Proyectos</h1>
  <p class="text-gray-400 text-center mt-2">
    Algunos de los proyectos en los que he trabajado.
  </p>

  <div class="grid md:grid-cols-2 gap-6 mt-6">
    {projects.map((project) => <ProjectCard {...project} />)}
  </div>
</section>
