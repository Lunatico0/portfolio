---
const { title, description, link, tech } = Astro.props;
---
<div class="bg-gray-800 p-4 rounded-lg shadow-lg">
  <h2 class="text-xl font-semibold text-white">{title}</h2>
  <p class="text-gray-400 mt-2">{description}</p>
  <div class="mt-2">
    {tech.map((t) => (
      <span class="bg-gray-700 text-gray-300 px-2 py-1 text-xs rounded-md mr-2">{t}</span>
    ))}
  </div>
  <a href={link} target="_blank" class="block mt-4 text-blue-400 hover:underline">
    Ver proyecto →
  </a>
</div>
