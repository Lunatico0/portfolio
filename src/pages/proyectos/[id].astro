---
import Layout from "../../layouts/Layout.astro";
import projects from "../../data/projects.json";

// 🔹 Generar rutas dinámicas
export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
  }));
}

// 🔹 Obtener el ID y datos del proyecto
const { id } = Astro.params;
const project = projects.find((p) => p.id === id);

// 🔹 Si el proyecto no existe, mostrar error
if (!project) {
  throw new Error(`🚨 Proyecto no encontrado: ${id}`);
}
---

<Layout>
  <head>
    <title>{project.title} | Portfolio</title>
  </head>

  <section class="max-w-6xl mx-auto py-12 px-6">
    <!-- 🔹 Título -->
    <h1 class="text-5xl font-bold text-white text-center my-6">{project.title}</h1>

    <!-- 🔹 Contenedor de imágenes -->
    <div class="relative w-full flex flex-col md:flex-row items-center gap-6">
      <img src={project.images.desktop[0]} alt={project.title}
        class="w-full md:w-1/2 rounded-lg shadow-lg object-cover" />

      <div class="md:w-1/2">
        <p class="text-gray-400 text-lg">{project.description}</p>
        <h2 class="text-2xl font-semibold text-white mt-6">Tecnologías Utilizadas</h2>
        <div class="flex flex-wrap gap-2 mt-2">
          {project.tech.map(tech => (
            <span class="bg-gray-700 text-gray-300 px-3 py-1 rounded-md">{tech}</span>
          ))}
        </div>

        <h2 class="text-2xl font-semibold text-white mt-6">Detalles Técnicos</h2>
        <p class="text-gray-400 mt-2">{project.details}</p>

        <div class="flex gap-4 mt-6">
          <a href={project.link} target="_blank" class="bg-blue-600 text-white px-4 py-2 rounded-md">Ver Proyecto</a>
          <a href={project.github} target="_blank" class="bg-gray-700 text-white px-4 py-2 rounded-md">GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
