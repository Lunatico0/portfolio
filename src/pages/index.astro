---
import Layout from "../layouts/Layout.astro";
---
<Layout>
  <section class="min-h-screen flex flex-col justify-center items-center text-center px-4">
    <h1 class="text-5xl font-bold text-white">¡Hola, soy Patricio Pittana!</h1>
    <p class="text-gray-400 mt-4 max-w-2xl">
      Desarrollador Backend especializado en Node.js, Express y MongoDB.
      Apasionado por optimizar código y construir aplicaciones escalables.
    </p>
    <div class="mt-6 flex gap-4">
      <a href="/contacto" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg">
        Contáctame
      </a>
      <a href="https://github.com/Lunatico0" target="_blank" class="border border-gray-400 text-white px-6 py-2 rounded-lg hover:bg-gray-700">
        GitHub
      </a>
    </div>
  </section>
</Layout>
